QINYUAN_LLM_BACKEND=openai
QINYUAN_MODEL=deepseek-v4-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MAX_TOKENS=8192
OPENAI_API_KEY=
OPENAI_BASE_URL=
# QINYUAN_MODEL=gpt-5.5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
QINYUAN_MCP_SERVERS=shell,curl,php,download,libc_database
QINYUAN_SANDBOX_IMAGE=qinyuan/pentest-sandbox:0.3.4
QINYUAN_TOOL_BOOTSTRAP_TIMEOUT_SECONDS=300
QINYUAN_TOOL_BOOTSTRAP_BUDGET_SECONDS=300
QINYUAN_SANDBOX_NETWORK=qinyuan_pentest_egress
QINYUAN_SANDBOX_NETWORK_INTERNAL=false
# D8 model stream timeouts (seconds); all are capped by TaskRun remaining time.
QINYUAN_LLM_TIMEOUT_SECONDS=600
QINYUAN_LLM_CONNECT_TIMEOUT_SECONDS=10
QINYUAN_LLM_FIRST_OUTPUT_TIMEOUT_SECONDS=180
QINYUAN_LLM_IDLE_TIMEOUT_SECONDS=60
QINYUAN_LLM_MAX_RETRIES=1
