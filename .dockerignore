.uv-cache/
.test/
.runs/
workbench_data/
dist/
frontend/
tests/
Plan/
agent_adapters/
agent_core/
qinyuan_core/
Challenge/
Control/
restrict/
scripts/
**/__pycache__/
*.pyc
.git/
