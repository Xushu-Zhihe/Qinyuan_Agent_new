{
  "mcpServers": {
    "nmap": {
      "transport": "stdio",
      "command": "{python}",
      "cwd": "../Nmap_Mcp",
      "args": ["server.py"],
      "env": {
        "MCP_NMAP_ALLOWED_TARGETS": "127.0.0.1,localhost,target-web",
        "MCP_NMAP_MAX_PORTS": "1024"
      },
      "tags": ["network-scan", "reconnaissance"],
      "sandboxTools": ["nmap"],
      "enabled": true
    },
